{
  "name": "orchestratekit-mcp",
  "version": "0.1.0",
  "description": "Local stdio MCP server for OrchestrateKit — evidence-backed playbooks for AI workflow design.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchestratemcp/OrchestrateKIT-MCP.git"
  },
  "homepage": "https://orchestratemcp.dev",
  "bugs": {
    "url": "https://github.com/orchestratemcp/OrchestrateKIT-MCP/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "workflow-planning",
    "workflow-automation"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start:http": "tsx src/server-http.ts",
    "start": "node dist/server-http.js",
    "build": "pnpm gen:registry && tsup src/server.ts src/server-http.ts --format esm --out-dir dist --clean && node -e \"const{cpSync,writeFileSync}=require('fs');cpSync('registry','dist/registry',{recursive:true});writeFileSync('dist/registry/_build_manifest.json',JSON.stringify({built_at:new Date().toISOString()}));console.log('registry/ copied to dist/registry/ with build manifest')\"",
    "typecheck": "tsc --noEmit",
    "gen:registry": "tsx scripts/gen-registry-bundle.ts",
    "dev:worker": "pnpm gen:registry && wrangler dev",
    "deploy:worker": "pnpm gen:registry && wrangler deploy",
    "test": "vitest run",
    "registry:lint": "tsx scripts/registry-lint.ts",
    "export:obsidian": "tsx scripts/export-obsidian.ts",
    "export:safe": "tsx scripts/export-safe.ts",
    "export:safe:check": "tsx scripts/check-safe-export.ts",
    "probe": "tsx scripts/node-probes.ts",
    "benchmark": "pnpm gen:registry && tsx scripts/public-benchmark.ts",
    "benchmark:write": "pnpm gen:registry && tsx scripts/public-benchmark.ts --write",
    "benchmark:check": "pnpm gen:registry && tsx scripts/public-benchmark.ts --check",
    "demo": "tsx scripts/smoke-demo.ts",
    "smoke": "vitest run tests/smoke",
    "release:check": "tsx scripts/check-release-trust.ts",
    "state:check": "node scripts/check-project-state.mjs",
    "dash:schema:check": "node scripts/check-dash-schema-drift.mjs",
    "verify": "pnpm state:check && pnpm dash:schema:check && pnpm dash:vocab:check:local && pnpm gen:registry && pnpm typecheck && pnpm registry:lint && pnpm benchmark:check && pnpm test && pnpm release:check",
    "dash:vocab:check": "tsx scripts/check-dash-vocabulary-drift.ts",
    "dash:vocab:check:local": "tsx scripts/check-dash-vocabulary-drift.ts --allow-missing"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "js-yaml": "^4.3.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "hono@<4.12.34": "4.12.34",
      "@hono/node-server@<2.0.10": "2.0.10",
      "fast-uri@<3.1.5": "3.1.5",
      "postcss@<8.5.23": "8.5.25",
      "sharp@<0.35.0": "0.35.3",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
